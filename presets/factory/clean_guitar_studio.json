{
  "name": "Clean Studio Guitar",
  "category": "Guitar",
  "instrument": "guitar",
  "guitar_source": "audio",
  "sound": "builtin:clean_guitar",
  "description": "Gate, gentle comp, clean amp, chorus and plate.",
  "chain": [
    {
      "type": "gate",
      "params": {
        "threshold": -58
      }
    },
    {
      "type": "compressor",
      "params": {
        "threshold": -24,
        "ratio": 3,
        "attack": 8,
        "release": 150,
        "makeup": 4
      }
    },
    {
      "type": "amp",
      "params": {
        "gain": 6,
        "bass": 2,
        "middle": 0,
        "treble": 2,
        "master": -6,
        "cab": 1
      }
    },
    {
      "type": "chorus",
      "params": {
        "rate": 0.7,
        "depth": 2,
        "mix": 0.3
      }
    },
    {
      "type": "reverb",
      "params": {
        "size": 0.6,
        "mix": 0.2
      }
    }
  ],
  "master": {
    "volume": -6,
    "pan": 0,
    "input_gain": 0,
    "instrument_level": 0,
    "mute": false,
    "limiter": true,
    "eq": {
      "enabled": true,
      "params": {}
    },
    "comp": {
      "enabled": false,
      "params": {}
    }
  }
}