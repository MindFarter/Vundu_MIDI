{
  "name": "Vintage Electric Piano",
  "category": "Keyboard",
  "instrument": "keyboard",
  "sound": "builtin:electric_piano",
  "description": "Tine piano with stereo tremolo and chorus.",
  "chain": [
    {
      "type": "overdrive",
      "params": {
        "drive": 6,
        "tone": 4200,
        "level": -3,
        "mix": 0.6
      }
    },
    {
